# Copie ce fichier en .env et remplis avec les valeurs de ton projet Supabase
# (Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ta_cle_anon_publique

# Paiement Mobile Money (Kkiapay) — clé PUBLIQUE uniquement, sans danger
# à exposer côté navigateur. La clé privée reste côté serveur (secrets
# de l'Edge Function verifier-paiement-abonnement, jamais ici).
VITE_KKIAPAY_PUBLIC_KEY=ta_cle_publique_kkiapay
VITE_KKIAPAY_SANDBOX=true
